{
  "name": "retro-puzzle-game",
  "version": "1.0.0",
  "description": "A 90's-style puzzle game built with vanilla JavaScript and HTML5 Canvas",
  "main": "src/index.html",
  "scripts": {
    "dev": "webpack serve --mode development",
    "dev:3000": "PORT=3000 webpack serve --mode development",
    "dev:8080": "PORT=8080 webpack serve --mode development",
    "build": "webpack --mode production",
    "serve": "http-server dist -c-1 -o",
    "lint": "eslint src/js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\""
  },
  "keywords": [
    "game",
    "puzzle",
    "90s",
    "retro",
    "canvas",
    "javascript",
    "open-source"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/retro-puzzle-game.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/retro-puzzle-game/issues"
  },
  "homepage": "https://github.com/yourusername/retro-puzzle-game#readme",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "html-webpack-plugin": "^5.5.4",
    "http-server": "^14.1.1",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
